#!/usr/bin/env bash
set -e
# Minimal Maven wrapper launcher: downloads the wrapper JAR if missing and invokes it.
BASEDIR=$(dirname "$0")
WRAPPER_DIR="$BASEDIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_URL="https://repo1.maven.org/maven2/io/takari/maven-wrapper/0.5.6/maven-wrapper-0.5.6.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Maven wrapper JAR not found; downloading..."
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$WRAPPER_JAR" "$WRAPPER_URL"
  else
    echo "Please install curl or wget, or run the included install-maven-wrapper.ps1 on Windows." >&2
    exit 1
  fi
fi

java -jar "$WRAPPER_JAR" "$@"
